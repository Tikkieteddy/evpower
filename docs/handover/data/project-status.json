  "issues": [
    {
      "severity": "Critical",
      "title": "Default admin credential is public",
      "detail": "Hard-coded in src/utils/auth.js, printed in README.md, shipped in the deployed JS bundle, and the repository is public. Anyone can log in to any browser that still uses the default."
    },
    {
      "severity": "Critical",
      "title": "Plaintext client-side authentication",
      "detail": "Users/passwords/roles live in Local Storage; not a security boundary."
    },
    {
      "severity": "High",
      "title": "Local data loss",
      "detail": "No export/backup/sync yet; clearing site data deletes everything. Unreadable data is now copied before fallback (stage 1 done)."
    },
    {
      "severity": "High",
      "title": "Energy semantics",
      "detail": "Charged kWh is presented as consumed kWh and attributed to the route recorded on the charging day."
    },
    {
      "severity": "High",
      "title": "Mixed repository",
      "detail": "Unrelated Next.js profile workflow tracked beside EV; it contains real Google Sheet/Drive IDs in .env.example/config.ts and a hard-coded fallback approval secret in src/lib/approval.ts."
    },
    {
      "severity": "Medium",
      "title": "No component/E2E tests",
      "detail": "Unit tests cover utils (npm test); UI flows and CI are untested."
    },
    {
      "severity": "Medium",
      "title": "Large bundle",
      "detail": "Single 652 kB JS chunk (Recharts)."
    },
    {
      "severity": "Low",
      "title": "Week key timezone shift",
      "detail": "getWeekKey uses toISOString() on local midnight, so start/end are one day early in UTC+7. Grouping is consistent and the label is correct, so no visible bug today."
    },
    {
      "severity": "Low",
      "title": "Default form date uses UTC",
      "detail": "DailyLog blankForm uses toISOString(); before 07:00 Bangkok time the date field pre-fills yesterday."
    },
    {
      "severity": "Medium",
      "title": "Dependency advisories",
      "detail": "npm audit: 10 pre-existing advisories in the Vite/PostCSS/esbuild/babel toolchain (build-time). Try npm audit fix (non-force)."
    },
    {
      "severity": "Low",
      "title": "README outdated",
      "detail": "Says session is in Local Storage (code uses Session Storage); project structure list incomplete."
    }
  ],
